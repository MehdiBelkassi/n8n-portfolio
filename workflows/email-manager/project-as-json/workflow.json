        "categories": {
          "categories": [
            {
              "category": "social",
              "description": "Notifications from social networks and community platforms — new followers, likes, comments, mentions, friend requests, or activity digests (LinkedIn, Instagram, Facebook, X, Reddit, Discord). Not a message from a real person you know — an automated platform notification."
            },
            {
              "category": "Promotions",
              "description": "Marketing emails from brands/services you already have a relationship with — newsletters, product announcements, \"new arrivals,\" general marketing content. No urgency, no discount code."
            },
            {
              "category": "Action required",
              "description": "Emails where you must personally do something with a deadline or consequence — sign a document, confirm an appointment, respond to a request, verify an account, pay an overdue bill, approve something. Test: is there a specific action only you can take, and does ignoring it cost you something?"
            },
            {
              "category": "personal",
              "description": "A direct email written by an actual individual to you specifically — friends, family, colleagues, or 1:1 correspondence. Not automated, not bulk-sent. Test: could this only have been written by someone who knows you?"
            },
            {
              "category": "receipts",
              "description": "Confirmation of a completed transaction — order confirmations, payment receipts, invoices, subscription renewal charges, delivery confirmations. Test: money has already been spent/charged; this is a record, not a request."
            },
            {
              "category": "uncategorized",
              "description": "Anything that doesn't clearly fit the above — automated system emails with no action needed, unclear senders, or content that doesn't match any pattern above with confidence."
            },
            {
              "category": "offers",
              "description": "Marketing emails specifically containing a discount, coupon, deal, or limited-time incentive (\"20% off,\" \"flash sale,\" \"ends tonight\"). Test: is there a specific dollar/percent discount or promo code? If yes → offers. If it's just general brand content → Promotions."
            },
            {
              "category": "recruitment",
              "description": "Emails related to a hiring process — from either side (candidate or recruiter/company) — covering job applications, interview scheduling, offers, rejections, or recruiter outreach. Test: Is the email about a specific person being considered for, or pursuing, a specific job (application, interview, offer, rejection, or sourcing outreach)?"
            }
          ]
        },
        "options": {}
      },
