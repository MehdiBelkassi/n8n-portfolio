      "parameters": {
        "jsCode": "const output = $input.first().json.output;\n\n// Remove literal \\n characters\nlet cleaned = output.replace(/\\\\n/g, '').trim();\n\n// Fix common AI JSON mistakes:\n// 1. Replace any single-quoted strings with double quotes\n// 2. Remove trailing commas before ]\ncleaned = cleaned\n  .replace(/'/g, '\"')           // fix single quotes → double quotes\n  .replace(/,\\s*]/g, ']')       // fix trailing commas\n  .replace(/,\\s*}/g, '}');      // fix trailing commas in objects\n\nconst urls = JSON.parse(cleaned);\n\nreturn urls.map(url => ({\n  json: { url }\n}));"
      },
