        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst html = item.json.body || item.json.data || JSON.stringify(item.json);\n\nconst sorryMessage = 'Sorry, there are no Best Sellers available in this category. Please check back later.';\n\nconst error = item.json.error;\nconst cleanError = (!error || error === 'undefined' || error === '{}' || \n                    (typeof error === 'object' && Object.keys(error).length === 0))\n                    ? ''\n                    : String(error);\n\nif (html && html.includes(sorryMessage)) {\n  return { ...item.json, data: html, error: 'no_bestsellers' };\n}\n\n// Always output 'data' field so HTML node can find it\nreturn { ...item.json, data: html, error: cleanError };"
