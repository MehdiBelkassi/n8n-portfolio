        "jsCode": "const item = items[0];\nconst imageUrl = item.json.image_url;\n\nconst resizedUrl = `https://images.weserv.nl/?url=${encodeURIComponent(imageUrl)}&w=1000&h=1500&fit=contain&bg=ffffff&output=jpg`;\n\nreturn [\n  {\n    json: {\n      pin_title: item.json.pin_title,\n      description: item.json.description,\n      tags: item.json.tags,\n      asin: item.json.asin,\n      title: item.json.title,\n      image_url: resizedUrl\n    }\n  }\n];"
