        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  \n  for (let i = 0; i < data.rank.length; i++) {\n    output.push({\n      json: {\n        rank:  data.rank[i],\n        asin:  data.asin[i],\n        title: data.title[i],\n        price: data.price[i],\n        image: data.image[i],\n        link:  data.link[i],\n      }\n    });\n  }\n}\n\nreturn output;"
